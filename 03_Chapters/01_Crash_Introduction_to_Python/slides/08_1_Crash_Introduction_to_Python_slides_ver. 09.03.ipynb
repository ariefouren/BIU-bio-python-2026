    }
   },
   "outputs": [],
   "source": [
    "# List concatenation with + operator\n",
    "positive_aa = [\"Lysine\", \"Arginine\"]\n",
    "negative_aa = [\"Aspartic acid\", \"Glutamic acid\"]\n",
    "charged = positive_aa + negative_aa\n",
    "charged\n"
   ]
  },
