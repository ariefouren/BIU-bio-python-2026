   "source": [
    "# assignment operator\n",
    "x = 0\n",
    "x += 1  # short hand for x = x + 1\n",
    "print(x)\n",
    "x *= 2  # short hand for x = x * 2\n",
    "print(x)\n",
    "x **= 3 \n",
    "print(x)\n",
    "x /= 2\n",
    "print(x)"
   ]
