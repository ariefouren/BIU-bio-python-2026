   "source": [
    "## Iteration with `while` loops\n",
    "\n",
    "A `while` loop repeats as long as a condition remains true.\n",
    "\n",
    "This version rewrites GC content with an explicit running index.\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {
    "id": "12a1b00e",
    "slideshow": {
     "slide_type": "subslide"
    }
   },
   "outputs": [],
   "source": [
    "def GC_content3(dna_string):\n",
    "    ''' calculate %GC in dna string (uppercase ACTG) '''\n",
    "    GC = 0\n",
    "    i = 0\n",
    "    while i < len(dna_string):\n",
    "        if dna_string[i] == \"C\" or dna_string [i] == \"G\":\n",
    "            GC += 1\n",
    "        i += 1\n",
    "    return 100*GC/len(dna_string)\n"
   ]
  },
