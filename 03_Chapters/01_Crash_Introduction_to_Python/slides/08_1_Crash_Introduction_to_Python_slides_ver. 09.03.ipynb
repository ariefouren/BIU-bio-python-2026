   "source": [
    "# matrix is a list of lists\n",
    "# each inner list represents a row of the matrix\n",
    "matrix = [[1, 2, 3], [4, 5, 6], [7, 8, 9]] \n",
    "\n",
    "print(matrix[0]) # first row of the matrix\n",
    "print(matrix[0][0]) # first element of the first row of the matrix\n",
    "print(matrix[0][1]) # second element of the first row of the matrix\n",
    "print(matrix[0][2]) # third element of the first row of the matrix\n"
   ]
