    "def state(Tm, Tv, T):\n",
    "    ''' return the state of material with Tm and Tv at temperature T '''\n",
    "    if T < Tm:\n",
    "        return \"solid\"\n",
    "    else:\n",
    "        if T < Tv:\n",
    "            return \"liquid\"\n",
    "        else:\n",
    "            return \"gas\"\n"
   ]
