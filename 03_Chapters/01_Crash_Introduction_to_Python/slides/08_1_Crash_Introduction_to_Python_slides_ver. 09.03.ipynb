    "def basic_aa_perc(prot):\n",
    "    ''' return percentage of basic amino acids in protein '''\n",
    "    basic = 0\n",
    "    basic_aa_list = [\"K\", \"H\", \"R\"]\n",
    "    for aa in prot:\n",
    "        if aa in basic_aa_list:\n",
    "            basic += 1\n",
    "    return 100*basic/len(prot)\n"
   ]
  },
