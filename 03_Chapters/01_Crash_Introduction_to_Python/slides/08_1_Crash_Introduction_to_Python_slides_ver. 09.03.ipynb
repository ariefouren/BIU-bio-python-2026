  {
   "cell_type": "markdown",
   "id": "48fc583e",
   "metadata": {},
   "source": [
    "# Membership test for strings and lists\n",
    "Use `in` to check if a substring is present in a string, or if an element is present in a list."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 117,
   "metadata": {
    "id": "78794dec",
    "slideshow": {
     "slide_type": "fragment"
    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "True\n",
      "True\n",
      "False\n"
     ]
    }
   ],
   "source": [
    "organism = \"drosophila\"\n",
    "print(\"p\" in organism)\n",
    "print(\"phila\" in organism)\n",
    "print(\"x\" in organism)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 118,
   "metadata": {
    "id": "b07fed32",
    "slideshow": {
     "slide_type": "fragment"
    }
   },
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "True\n",
      "False\n"
     ]
    }
   ],
   "source": [
    "print(1 in [1,2,3])\n",
    "print(\"1\" in [1,2,3])"
   ]
  },
  {
